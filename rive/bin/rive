#!/usr/bin/env bash
# Rive CLI - Ephemeral review app manager
# Version: 1.1.0

set -euo pipefail

# Resolves ${BASH_SOURCE[0]} all the way through any symlinks (including
# chains of them) and prints the directory the REAL underlying file lives
# in - not the directory the symlink itself sits in. The documented install
# puts a symlink on PATH pointing back into this repo, and plain
# `dirname "${BASH_SOURCE[0]}"` would give the symlink's folder, making the
# lib/ lookup below fail. Written by hand with `readlink` + a loop rather
# than `readlink -f`, since macOS's stock BSD `readlink` doesn't support -f.
resolve_script_dir() {
    local source dir
    source="${BASH_SOURCE[0]}"
    while [ -h "$source" ]; do
        dir="$(cd -P "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        # A relative symlink target is relative to the symlink's own
        # directory, not to wherever we currently are - resolve it there.
        [[ "$source" == /* ]] || source="$dir/$source"
    done
    cd -P "$(dirname "$source")" && pwd
}

# Script directory
SCRIPT_DIR="$(resolve_script_dir)"
LIB_DIR="$(dirname "$SCRIPT_DIR")/lib"

# Source library modules
source "$LIB_DIR/utils.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/state.sh"
source "$LIB_DIR/scope.sh"
source "$LIB_DIR/port.sh"
source "$LIB_DIR/worktree.sh"
source "$LIB_DIR/process.sh"

# Show help
show_help() {
    cat << EOF
Rive - Ephemeral review app manager

USAGE:
    rive <command> [options] [arguments]

COMMANDS:
    add [branch]         Create a new review app from a git branch
                         If no branch is specified, shows interactive selection
      (aliases: start, create, new, up)
    list                 List all running review apps
      (aliases: ls, l)
    status [branch|port] Show detailed info for one app (uses current if not specified)
    remove [branch|port] Stop a review app (uses current if not specified)
                         Use 'rive remove all' to stop every app in scope
      (aliases: stop, delete, del, down, rm)
    restart [branch]     Restart a review app (uses current if not specified)
    cd [branch|port]     Print the path to a review app's worktree
    pull [branch|port]   Pull latest changes in a review app's worktree
    logs [branch|port]   Tail the log file for a review app (uses current if not specified)
    use [branch|port]    Set current app context (show current if not specified)
    config               Show current configuration
    demo-server <port>   Run a throwaway server, for trying rive out
    clean                Clean up stale state entries
    help                 Show this help message
    version              Show version information
      (also: -V, --version)

OPTIONS:
    --verbose, -v        Enable verbose output
    --version, -V        Show version information
    --global, -G         Act across every repository (aliases: --all, -a)
    --start-port PORT    Override starting port for allocation
    --hostname HOST      Override hostname for server binding
    --worktree-dir DIR   Override worktree base directory

    Note: -v is verbose, -V is version - as in curl, ssh and python.

SCOPE:
    By default rive acts on the repository you are standing in. Outside a git
    repository it acts on everything. Widen a single command with --global
    (-G), or change the default with RIVE_DEFAULT_SCOPE=global.

    Name an app in another repository directly with repo:branch, e.g.
        rive status my-web:main
        rive remove my-api:main

CONFIGURATION:
    Configuration is loaded from (in order of precedence):
    1. CLI flags (highest)
    2. .env file in current directory
    3. Environment variables (lowest)

    Available variables:
    - RIVE_START_PORT        Starting port (default: 40000)
    - RIVE_HOSTNAME          Hostname for server binding (default: localhost)
    - RIVE_WORKTREE_DIR      Worktree directory (default: ~/.rive/worktrees)
    - RIVE_SERVER_COMMAND    Server command with %PORT% placeholder
    - RIVE_STATE_FILE        State file location (default: ~/.rive/state)
    - RIVE_AUTO_INSTALL      Auto-install dependencies (default: false)
    - RIVE_INSTALL_COMMAND   Custom install command (default: auto-detected)
    - RIVE_ENABLE_LOGS       Log server output to .rive-server.log (default: false)
    - RIVE_VERBOSE           Verbose output (default: false)
    - RIVE_DEFAULT_SCOPE     'local' or 'global' (default: local)
    - RIVE_CURRENT_FILE      Current-app pointer (default: ~/.rive/current)

EXAMPLES:
    # Create a review app (interactive branch selection)
    rive add

    # Create a review app for a specific branch
    rive add feature/new-ui

    # List all review apps
    rive list

    # Set current app context
    rive use feature/new-ui

    # Now you can use commands without specifying the app
    rive cd              # Navigate to current app
    rive pull            # Pull latest changes for current app
    rive remove          # Remove current app

    # Remove a review app by branch name
    rive remove feature/new-ui

    # Remove a review app by port
    rive remove 40000

    # Navigate to review app directory
    cd \$(rive cd feature/new-ui)

    # Show configuration
    rive config

EOF
}

# Command: create
cmd_create() {
    local branch="${1:-}"

    # If no branch specified, show interactive selection
    if [[ -z "$branch" ]]; then
        log_info "No branch specified, showing branch selection..."
        if ! branch=$(select_branch_interactive); then
            return 1
        fi
        log_debug "Selected branch: $branch"
    fi

    # Check if this is the current branch
    local current_branch
    current_branch=$(git branch --show-current 2>/dev/null)
    if [[ "$branch" == "$current_branch" ]]; then
        log_info "Selected branch '$branch' is the current branch"
        log_info "Starting server in current directory..."

        # Get current working directory (the repo root)
        local worktree
        worktree=$(git rev-parse --show-toplevel)

        # Check if we already have an app for this branch
        if state_has_app "$branch" "$(get_repo_key 2>/dev/null || echo "")"; then
            local existing_port
            existing_port=$(get_port_for_branch "$branch")
            log_error "Review app already exists for branch: $branch"
            log_info "Running on port $existing_port"
            log_info "Use 'rive stop $branch' to stop it first"
            return 1
        fi

        # Find available port
        local port
        port=$(find_available_port) || {
            error_exit 30 "Could not allocate port"
        }

        # Install dependencies if configured
        install_dependencies "$worktree" || {
            log_warning "Dependency installation failed, continuing..."
        }

        # Start server
        local pid
        if ! pid=$(start_server "$port" "$worktree"); then
            log_error "Failed to start server"
            return 1
        fi

        # Verify we got a PID
        if [[ -z "$pid" ]]; then
            log_error "Server start returned empty PID"
            return 1
        fi

        # Save state
        if ! state_add_app "$branch" "$port" "$worktree" "$pid" "$(get_repo_key 2>/dev/null || echo "")"; then
            log_error "Failed to save state, cleaning up..."
            stop_server "$pid"
            return 1
        fi

        # Set as current app
        set_current_app "$branch"
        log_debug "Set as current app"

        # Success message
        echo ""
        log_success "Review app started in current directory!"
        echo ""
        echo "  Branch:   $branch"
        echo "  Directory: $worktree"
        echo "  PID:      $pid"
        echo ""
        echo "  URL:      http://localhost:$port"
        echo ""
        return 0
    fi

    # Check if branch already has a worktree
    local existing_worktree
    existing_worktree=$(get_worktree_for_branch "$branch")

    if [[ -n "$existing_worktree" ]]; then
        log_info "Branch '$branch' already has a worktree at: $existing_worktree"

        # Check if review app already exists for this branch
        if state_has_app "$branch" "$(get_repo_key 2>/dev/null || echo "")"; then
            local existing_port
            existing_port=$(get_port_for_branch "$branch")
            log_error "Review app already running for branch: $branch"
            log_info "Running on port $existing_port at $existing_worktree"
            log_info "Use 'rive stop $branch' to stop it first"
            return 1
        fi

        log_info "Using existing worktree to start review app..."

        # Find available port
        local port
        port=$(find_available_port) || {
            error_exit 30 "Could not allocate port"
        }

        # Install dependencies if configured
        install_dependencies "$existing_worktree" || {
            log_warning "Dependency installation failed, continuing..."
        }

        # Start server
        local pid
        if ! pid=$(start_server "$port" "$existing_worktree"); then
            log_error "Failed to start server"
            return 1
        fi

        # Verify we got a PID
        if [[ -z "$pid" ]]; then
            log_error "Server start returned empty PID"
            return 1
        fi

        # Save state
        if ! state_add_app "$branch" "$port" "$existing_worktree" "$pid" "$(get_repo_key 2>/dev/null || echo "")"; then
            log_error "Failed to save state, cleaning up..."
            stop_server "$pid"
            return 1
        fi

        # Set as current app
        set_current_app "$branch"
        log_debug "Set as current app"

        # Success message
        echo ""
        log_success "Review app started using existing worktree!"
        echo ""
        echo "  Branch:   $branch"
        echo "  Worktree: $existing_worktree"
        echo "  PID:      $pid"
        echo ""
        echo "  URL:      http://localhost:$port"
        echo ""
        return 0
    fi

    # No existing worktree, create a new one
    # Check if review app already exists (shouldn't happen but double-check)
    if state_has_app "$branch" "$(get_repo_key 2>/dev/null || echo "")"; then
        local existing_port
        existing_port=$(get_port_for_branch "$branch")
        log_error "Review app already exists for branch: $branch"
        log_info "Running on port $existing_port"
        log_info "Use 'rive stop $branch' to stop it first"
        return 1
    fi

    # Find available port
    local port
    port=$(find_available_port) || {
        error_exit 30 "Could not allocate port"
    }

    # Create worktree
    local worktree
    if ! worktree=$(create_worktree "$branch"); then
        # Error already logged by create_worktree
        return 1
    fi

    # Install dependencies if configured
    install_dependencies "$worktree" || {
        log_warning "Dependency installation failed, continuing..."
    }

    # Start server
    local pid
    if ! pid=$(start_server "$port" "$worktree"); then
        log_error "Failed to start server, cleaning up..."
        remove_worktree "$worktree" || true
        return 1
    fi

    # Verify we got a PID
    if [[ -z "$pid" ]]; then
        log_error "Server start returned empty PID, cleaning up..."
        remove_worktree "$worktree" || true
        return 1
    fi

    # Save state
    if ! state_add_app "$branch" "$port" "$worktree" "$pid" "$(get_repo_key 2>/dev/null || echo "")"; then
        log_error "Failed to save state, cleaning up..."
        stop_server "$pid"
        remove_worktree "$worktree" || true
        return 1
    fi

    # Set as current app
    set_current_app "$branch"
    log_debug "Set as current app"

    # Success message
    echo ""
    log_success "Review app created successfully!"
    echo ""
    echo "  Branch:   $branch"
    echo "  Worktree: $worktree"
    echo "  PID:      $pid"
    echo ""
    echo "  URL:      http://localhost:$port"
    echo ""
}

# Command: list
cmd_list() {
    local scope="${RIVE_SCOPE:-local}"
    # Clean stale entries first
    state_clean_stale

    local apps
    apps=$(state_list_apps_in_scope "$scope")

    if [[ -z "$apps" ]]; then
        echo "No running review apps"
        return 0
    fi

    # Show a REPO column only when it carries information: either the user
    # asked for every repository, or the listing happens to span several.
    local show_repo=false
    if [[ "$scope" == "global" ]]; then
        show_repo=true
    fi

    # Print header
    if [[ "$show_repo" == "true" ]]; then
        printf "%-20s %-30s %-8s %-10s %-12s\n" \
            "REPO" "BRANCH" "PORT" "STATUS" "UPTIME"
        printf "%-20s %-30s %-8s %-10s %-12s\n" \
            "$(printf '%.0s─' {1..20})" \
            "$(printf '%.0s─' {1..30})" \
            "$(printf '%.0s─' {1..8})" \
            "$(printf '%.0s─' {1..10})" \
            "$(printf '%.0s─' {1..12})"
    else
    printf "%-30s %-8s %-10s %-12s %-40s\n" \
        "BRANCH" "PORT" "STATUS" "UPTIME" "WORKTREE"
    printf "%-30s %-8s %-10s %-12s %-40s\n" \
        "$(printf '%.0s─' {1..30})" \
        "$(printf '%.0s─' {1..8})" \
        "$(printf '%.0s─' {1..10})" \
        "$(printf '%.0s─' {1..12})" \
        "$(printf '%.0s─' {1..40})"
    fi

    # List all apps
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue

        local branch port worktree pid timestamp status uptime
        branch=$(parse_state_line "$line" "branch")
        port=$(parse_state_line "$line" "port")
        worktree=$(parse_state_line "$line" "worktree")
        pid=$(parse_state_line "$line" "pid")
        timestamp=$(parse_state_line "$line" "timestamp")

        status=$(get_process_status "$pid")
        uptime=$(calculate_uptime "$timestamp")

        # Truncate worktree path if too long
        local worktree_display="$worktree"
        if [[ ${#worktree} -gt 38 ]]; then
            worktree_display="...${worktree: -35}"
        fi

        if [[ "$show_repo" == "true" ]]; then
            local repo
            repo=$(parse_state_line "$line" "repo")
            printf "%-20s %-30s %-8s %-10s %-12s\n" \
                "$(repo_display_name "$repo")" "$branch" "$port" "$status" "$uptime"
        else
            printf "%-30s %-8s %-10s %-12s %-40s\n" \
                "$branch" "$port" "$status" "$uptime" "$worktree_display"
        fi
    done <<< "$apps"

    # Local scope hides apps from other repositories. Say so rather than
    # leaving the user to wonder where their app went.
    if [[ "$scope" == "local" ]]; then
        local total hidden
        total=$(state_list_apps | grep -c . || true)
        hidden=$(( total - $(echo "$apps" | grep -c . || true) ))
        if (( hidden > 0 )); then
            echo ""
            echo "$hidden more in other repositories (rive list --global)"
        fi
    fi
}

# Command: stop
cmd_stop() {
    local identifier="${1:-}"

    # `all` is a positional keyword rather than a flag: --all is now one of the
    # spellings of global scope, so `rive remove all` stops everything in scope
    # and `rive remove all -a` stops everything everywhere.
    if [[ "$identifier" == "all" ]]; then
        cmd_stop_all
        return $?
    fi

    # Fall back to current app if no identifier provided
    if [[ -z "$identifier" ]]; then
        if ! identifier=$(get_current_app); then
            error_exit 1 "No app specified and no current app set. Usage: rive remove <branch|port|--all>"
        fi
        log_debug "Using current app: $identifier"
    fi

    stop_one_app "$identifier" || error_exit 1 "Failed to stop review app: $identifier"
}

# Stops a single app and cleans up after it. Returns non-zero rather than
# exiting, so `remove --all` can carry on past one bad entry.
stop_one_app() {
    local identifier="$1"

    # Try to find by branch first
    local app
    app=$(resolve_app "$identifier" "${RIVE_SCOPE:-local}") || return 1

    local branch pid worktree
    branch=$(parse_state_line "$app" "branch")
    pid=$(parse_state_line "$app" "pid")
    worktree=$(parse_state_line "$app" "worktree")

    # Stop server
    stop_server "$pid"

    # Remove from state. Keyed on the app's own repo so an identically named
    # branch in another repository is left alone.
    state_remove_app "$branch" "$(parse_state_line "$app" "repo")"

    # Clear current app if it was this branch
    if current=$(get_current_app 2>/dev/null); then
        if [[ "$current" == "$branch" ]]; then
            clear_current_app
            log_debug "Cleared current app (was stopped)"
        fi
    fi

    echo ""
    log_success "Review app stopped: $branch"
    echo ""

    # Check if worktree is clean and remove it
    if is_worktree_clean "$worktree"; then
        log_info "Worktree is clean, removing it..."
        if remove_worktree "$worktree"; then
            log_success "Worktree removed"
        fi
    else
        log_warning "Worktree has uncommitted changes, keeping it"
        echo "Worktree location: $worktree"
        echo ""
        echo "The worktree has uncommitted or untracked changes."
        echo "Please commit or discard changes, then remove manually:"
        echo "  git worktree remove $worktree"
    fi
    echo ""
    return 0
}

# Resolves the repository an app belongs to. The first entry of `git worktree
# list` is always the main working directory, which works whether the path is a
# linked worktree or the repo root itself (the current-branch case).
get_repo_for_worktree() {
    local worktree="$1"
    local main_worktree

    if [[ -d "$worktree" ]]; then
        main_worktree=$(git -C "$worktree" worktree list --porcelain 2>/dev/null \
            | head -1 | sed 's/^worktree //')
        if [[ -n "$main_worktree" ]]; then
            basename "$main_worktree"
            return 0
        fi
    fi

    # Worktree is gone (stale entry): fall back to the namespace directory rive
    # created it under, which is the repo name by construction
    basename "$(dirname "$worktree")"
}

# Command: status
cmd_status() {
    local identifier="${1:-}"

    # Fall back to current app if no identifier provided
    if [[ -z "$identifier" ]]; then
        if ! identifier=$(get_current_app); then
            error_exit 1 "No app specified and no current app set. Usage: rive status <branch|port>"
        fi
        log_debug "Using current app: $identifier"
    fi

    local app
    app=$(resolve_app "$identifier" "${RIVE_SCOPE:-local}") || exit 1

    local branch port worktree pid started
    branch=$(parse_state_line "$app" "branch")
    port=$(parse_state_line "$app" "port")
    worktree=$(parse_state_line "$app" "worktree")
    pid=$(parse_state_line "$app" "pid")
    started=$(parse_state_line "$app" "timestamp")

    local status uptime
    status=$(get_process_status "$pid") || true
    if [[ "$status" == "running" ]]; then
        uptime=$(calculate_uptime "$started")
    else
        uptime="-"
    fi

    local changes
    if [[ ! -d "$worktree" ]]; then
        changes="worktree missing"
    elif is_worktree_clean "$worktree"; then
        changes="clean"
    else
        changes="uncommitted changes"
    fi

    local log_file="$worktree/.rive-server.log"
    if [[ ! -f "$log_file" ]]; then
        log_file="none (set RIVE_ENABLE_LOGS=true)"
    fi

    local is_current="no"
    local current
    if current=$(get_current_app 2>/dev/null); then
        [[ "$current" == "$branch" ]] && is_current="yes"
    fi

    echo ""
    echo "Review app: $branch"
    echo ""
    printf "  %-13s %s\n" "Repository:"  "$(get_repo_for_worktree "$worktree")"
    printf "  %-13s %s\n" "Status:"      "$status"
    printf "  %-13s %s\n" "PID:"         "$pid"
    printf "  %-13s %s\n" "Uptime:"      "$uptime"
    printf "  %-13s %s\n" "Port:"        "$port"
    printf "  %-13s %s\n" "URL:"         "http://$RIVE_HOSTNAME:$port"
    printf "  %-13s %s\n" "Worktree:"    "$worktree"
    printf "  %-13s %s\n" "Changes:"     "$changes"
    printf "  %-13s %s\n" "Logs:"        "$log_file"
    printf "  %-13s %s\n" "Current app:" "$is_current"
    echo ""

    if [[ "$status" != "running" ]]; then
        log_warning "The server process is not running"
        log_info "Use 'rive restart $branch' to start it again, or 'rive clean' to drop the entry"
        echo ""
        return 1
    fi

    return 0
}

# Command: remove --all
cmd_stop_all() {
    local scope="${RIVE_SCOPE:-local}"
    local apps
    apps=$(state_list_apps_in_scope "$scope")

    if [[ -z "$apps" ]]; then
        if [[ "$scope" == "local" ]]; then
            echo "No running review apps in this repository"
        else
            echo "No running review apps"
        fi
        return 0
    fi

    # Snapshot the branch list before touching anything: stop_one_app rewrites
    # the state file as it goes, so iterating it live would skip entries.
    local branches=()
    local line branch repo
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        branch=$(parse_state_line "$line" "branch")
        repo=$(parse_state_line "$line" "repo")
        # Qualify so a same-named branch in another repository is not hit
        if [[ -n "$repo" ]]; then
            branch="$(repo_display_name "$repo"):$branch"
        fi
        [[ -n "$branch" ]] && branches+=("$branch")
    done <<< "$apps"

    local total=${#branches[@]}
    log_info "Stopping $total review app(s)..."

    local stopped=0 failed=0
    for branch in "${branches[@]}"; do
        if stop_one_app "$branch"; then
            stopped=$((stopped + 1))
        else
            failed=$((failed + 1))
            log_warning "Continuing with remaining apps..."
        fi
    done

    echo ""
    if (( failed > 0 )); then
        log_warning "Stopped $stopped of $total review app(s), $failed failed"
        echo ""
        return 1
    fi

    log_success "Stopped all $stopped review app(s)"
    echo ""
    return 0
}

# Command: restart
cmd_restart() {
    local branch="${1:-}"

    # Fall back to current app if no branch provided
    if [[ -z "$branch" ]]; then
        if ! branch=$(get_current_app); then
            error_exit 1 "No branch specified and no current app set. Usage: rive restart <branch>"
        fi
        log_debug "Using current app: $branch"
    fi

    restart_server "$branch"
}

# Command: cd
cmd_cd() {
    local identifier="${1:-}"

    # Fall back to current app if no identifier provided
    if [[ -z "$identifier" ]]; then
        if ! identifier=$(get_current_app); then
            error_exit 1 "No app specified and no current app set. Usage: rive cd <branch|port>"
        fi
        log_debug "Using current app: $identifier"
    fi

    # Try to find by branch first
    local app
    app=$(resolve_app "$identifier" "${RIVE_SCOPE:-local}") || exit 1

    local worktree
    worktree=$(parse_state_line "$app" "worktree")
    echo "$worktree"
}

# Command: pull
cmd_pull() {
    local identifier="${1:-}"

    # Fall back to current app if no identifier provided
    if [[ -z "$identifier" ]]; then
        if ! identifier=$(get_current_app); then
            error_exit 1 "No app specified and no current app set. Usage: rive pull <branch|port>"
        fi
        log_debug "Using current app: $identifier"
    fi

    # Try to find by branch first
    local app
    app=$(resolve_app "$identifier" "${RIVE_SCOPE:-local}") || exit 1

    local branch worktree
    branch=$(parse_state_line "$app" "branch")
    worktree=$(parse_state_line "$app" "worktree")

    log_info "Pulling latest changes for $branch"
    log_debug "Worktree: $worktree"

    # Get upstream configuration from the MAIN repo (not the worktree)
    local upstream
    if ! upstream=$(git rev-parse --abbrev-ref "$branch@{upstream}" 2>/dev/null); then
        log_error "Branch '$branch' has no upstream tracking branch configured"
        echo ""
        echo "To set one up, run:"
        echo "  git push -u origin $branch"
        return 1
    fi

    log_debug "Upstream from main repo: $upstream"

    # Parse remote and branch from upstream (format: remote/branch)
    local remote="${upstream%%/*}"
    local remote_branch="${upstream#*/}"

    log_debug "Remote: $remote, Branch: $remote_branch"

    # Change to worktree and pull explicitly
    if ! cd "$worktree"; then
        error_exit 1 "Failed to change to worktree directory: $worktree"
    fi

    log_info "Pulling from $remote/$remote_branch..."
    if git pull "$remote" "$remote_branch"; then
        log_success "Successfully pulled latest changes"
    else
        log_error "Git pull failed"
        echo ""
        echo "You may need to resolve conflicts."
        echo "Worktree location: $worktree"
        return 1
    fi
}

# Command: logs
cmd_logs() {
    local identifier="${1:-}"

    # Fall back to current app if no identifier provided
    if [[ -z "$identifier" ]]; then
        if ! identifier=$(get_current_app); then
            error_exit 1 "No app specified and no current app set. Usage: rive logs <branch|port>"
        fi
        log_debug "Using current app: $identifier"
    fi

    # Try to find by branch first
    local app
    app=$(resolve_app "$identifier" "${RIVE_SCOPE:-local}") || exit 1

    local branch worktree
    branch=$(parse_state_line "$app" "branch")
    worktree=$(parse_state_line "$app" "worktree")
    local log_file="$worktree/.rive-server.log"

    if [[ ! -f "$log_file" ]]; then
        log_error "Log file not found: $log_file"
        echo ""
        echo "Logs are only available when RIVE_ENABLE_LOGS=true or --verbose is used."
        echo "To enable logging for future apps, set:"
        echo "  RIVE_ENABLE_LOGS=true"
        echo ""
        echo "Or add to your .env file:"
        echo "  echo 'RIVE_ENABLE_LOGS=true' >> .env"
        return 1
    fi

    log_info "Showing logs for $branch"
    echo "Log file: $log_file"
    echo "Press Ctrl+C to exit"
    echo ""

    # Tail the log file, following it
    tail -f "$log_file"
}

# Command: demo-server
#
# A throwaway server for trying rive out, or for checking that a review app
# really did start and answer on its port. Set it as your server command:
#
#     RIVE_SERVER_COMMAND="rive demo-server %PORT%"
#
# Python's http.server is preferred: it serves the worktree directory, so you
# can see the branch's own files, and it keeps the port bound between requests.
# Without python3 we fall back to a netcat loop, which answers a fixed response
# and is fine for a quick check - but it rebinds the port after every request,
# so an occasional rapid request can arrive during the gap and be refused.
cmd_demo_server() {
    local port="${1:-}"
    local host="${RIVE_HOSTNAME:-localhost}"

    if [[ -z "$port" ]]; then
        log_error "No port specified"
        echo ""
        echo "Usage: rive demo-server <port>"
        echo ""
        echo "Typically used as the server command:"
        echo "  RIVE_SERVER_COMMAND=\"rive demo-server %PORT%\""
        return 1
    fi

    if ! [[ "$port" =~ ^[0-9]+$ ]]; then
        log_error "Invalid port: $port"
        return 1
    fi

    if command_exists python3; then
        log_info "Demo server on http://$host:$port (python3, serving $(pwd))"
        # exec so the process rive recorded is the server itself, not a wrapper
        exec python3 -m http.server "$port" --bind "$host"
    fi

    if ! command_exists nc; then
        log_error "Neither python3 nor nc is available"
        log_info "Install python3, or set RIVE_SERVER_COMMAND to your own server"
        return 1
    fi

    log_warning "python3 not found, falling back to nc"
    log_info "Demo server on http://$host:$port (nc)"
    demo_server_nc "$port"
}

# netcat fallback. `nc -l PORT` is the BSD/OpenBSD spelling; netcat-traditional
# rejects it and wants `-l -p PORT`. Work out which this one is by starting a
# listener and seeing whether it survives a moment.
demo_server_nc() {
    local port="$1"
    local body
    body="rive demo server
port: $port
directory: $(pwd)
"

    local listen_flags=(-l "$port")
    local probe
    nc -l "$port" </dev/null >/dev/null 2>&1 &
    probe=$!
    sleep 1
    if kill -0 "$probe" 2>/dev/null; then
        kill "$probe" 2>/dev/null
    else
        log_debug "netcat rejected -l <port>, using -l -p <port>"
        listen_flags=(-l -p "$port")
    fi
    wait "$probe" 2>/dev/null || true

    # One listener per request: nc exits when the client disconnects, so the
    # loop rebinds for the next one.
    while :; do
        printf 'HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s' \
            "${#body}" "$body" | nc "${listen_flags[@]}" >/dev/null 2>&1
    done
}

# Command: config
cmd_config() {
    show_config
}

# Command: clean
cmd_clean() {
    local scope="${RIVE_SCOPE:-local}"
    log_info "Cleaning stale entries..."
    state_clean_stale
    log_success "Stale entries cleaned"
}

# Command: use
cmd_use() {
    local identifier="${1:-}"

    # If --clear flag
    if [[ "$identifier" == "--clear" ]]; then
        clear_current_app
        log_success "Cleared current app"
        return 0
    fi

    # If no argument, check if we should show current or select interactively
    if [[ -z "$identifier" ]]; then
        local current
        if current=$(get_current_app 2>/dev/null); then
            # Show current app
            local app
            app=$(state_get_app "$current")
            if [[ -z "$app" ]]; then
                log_error "Current app no longer exists: $current"
                clear_current_app
                return 1
            fi

            local branch port worktree
            branch=$(parse_state_line "$app" "branch")
            port=$(parse_state_line "$app" "port")
            worktree=$(parse_state_line "$app" "worktree")

            echo "Current app: $branch"
            echo "  Port:     $port"
            echo "  Worktree: $worktree"
            echo "  URL:      http://localhost:$port"
            return 0
        else
            # No current app, offer interactive selection
            log_info "No current app set"

            # Check if there are any running apps
            local apps
            apps=$(state_list_apps)
            if [[ -z "$apps" ]]; then
                echo "No running review apps"
                echo ""
                echo "Usage: rive use <branch|port>"
                echo "   or: rive add [branch]"
                return 1
            fi

            # Offer to select from running apps
            log_info "Would you like to select from running apps? (y/n)"
            read -r response
            if [[ "$response" =~ ^[Yy] ]]; then
                # Show interactive selection of running apps
                log_info "Select a branch to switch to..."
                if ! identifier=$(select_branch_interactive); then
                    return 1
                fi
            else
                echo ""
                echo "Usage: rive use <branch|port>"
                return 1
            fi
        fi
    fi

    # Set current app. Resolve first so `rive use my-web:main` works and an
    # ambiguous bare name is reported rather than silently picking one.
    local resolved
    resolved=$(resolve_app "$identifier" "${RIVE_SCOPE:-local}") || exit 1
    identifier=$(parse_state_line "$resolved" "branch")

    if set_current_app "$identifier"; then
        local app="$resolved"

        local branch port
        branch=$(parse_state_line "$app" "branch")
        port=$(parse_state_line "$app" "port")

        log_success "Set current app to: $branch (port $port)"
        return 0
    else
        error_exit 1 "Review app not found: $identifier"
    fi
}

# Main entry point
main() {
    # Check dependencies first
    check_dependencies || exit 1

    # Scope flags are accepted anywhere on the line, not just before the
    # command: `rive list --global` is the form people reach for first, and
    # the positional parser below stops at the command name.
    local -a filtered=()
    local arg
    for arg in "$@"; do
        case "$arg" in
            --global|-G|--all|-a)
                export RIVE_SCOPE_FLAG=global
                ;;
            *)
                filtered+=("$arg")
                ;;
        esac
    done
    set -- ${filtered[@]+"${filtered[@]}"}

    # Parse global flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --verbose|-v)
                export RIVE_VERBOSE=true
                shift
                ;;
            --start-port)
                export RIVE_START_PORT="$2"
                shift 2
                ;;
            --hostname)
                export RIVE_HOSTNAME="$2"
                shift 2
                ;;
            --worktree-dir)
                export RIVE_WORKTREE_DIR="$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    # Initialize configuration
    init_config

    # Only commands that genuinely need repository context require one. The
    # rest work from the state file, so `rive list` or `rive remove` outside a
    # repo now succeed under the global scope they fall back to, rather than
    # being refused.
    local command="${1:-help}"
    case "$command" in
        add|start|create|new|up|pull)
            check_git_repo
            ;;
    esac

    # Initialize state
    init_state_file

    # Entries written before repositories were tracked get theirs derived, so
    # upgrading requires nothing of the user
    state_backfill_repos

    # Effective scope for this invocation: flag > RIVE_DEFAULT_SCOPE > local,
    # falling back to global outside a repository
    RIVE_SCOPE=$(resolve_scope)
    export RIVE_SCOPE
    log_debug "Scope: $RIVE_SCOPE"

    # Parse command
    case "$command" in
        add|start|create|new|up)
            shift
            cmd_create "$@"
            ;;
        list|ls|l)
            cmd_list
            ;;
        status)
            shift
            cmd_status "$@"
            ;;
        remove|stop|delete|del|down|rm)
            shift
            cmd_stop "$@"
            ;;
        restart)
            shift
            cmd_restart "$@"
            ;;
        cd)
            shift
            cmd_cd "$@"
            ;;
        pull)
            shift
            cmd_pull "$@"
            ;;
        logs)
            shift
            cmd_logs "$@"
            ;;
        use)
            shift
            cmd_use "$@"
            ;;
        config)
            cmd_config
            ;;
        demo-server)
            shift
            cmd_demo_server "$@"
            ;;
        clean)
            cmd_clean
            ;;
        version|-V|--version)
            echo "rive version 1.1.0"
            ;;
        help|-h|--help|"")
            show_help
            ;;
        *)
            log_error "Unknown command: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
