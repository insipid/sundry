#!/usr/bin/env python3
"""memories – search Firefox bookmarks & history.

Usage: ./bin/memories [--stop] [--status] [--port PORT] [--profile PATH] [--no-open]

Add bin/ to your PATH (or symlink bin/memories) for system-wide access:
    ln -s "$PWD/bin/memories" ~/.local/bin/memories
"""
import sys
import os

# Ensure the package is importable when running from any directory
_project_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _project_root not in sys.path:
    sys.path.insert(0, _project_root)

from memories.cli import main

main(sys.argv[1:])
